# Copy to labs/.env (scripts/lab.sh does it for you with random values).
# labs/.env is git-ignored. Passwords are read by the databases only on the
# first boot: after changing them, run scripts/lab-down.sh --purge.

GUAC_DB_PASSWORD=change-me
GUAC_ADMIN_PASSWORD=change-me
# VNC only uses the first 8 characters.
KALI_VNC_PASSWORD=change-me
KALI_VNC_GEOMETRY=1600x900
DVWA_DB_PASSWORD=change-me
DVWA_DB_ROOT_PASSWORD=change-me
# Password of the restricted Guacamole user "plataforma" (READ on the Kali
# connection only), used by the platform to open the Kali desktop (Phase 6).
# Applied on every lab start; letters and digits, 16 or more.
PLATFORM_GUAC_PASSWORD=change-me-with-16-plus-chars
